<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="accountnumber-sequence-3" author="fineract">
        <addColumn tableName="m_account_number_sequence">
            <column name="claimed_at" type="DATETIME"/>
        </addColumn>
    </changeSet>

    <changeSet id="accountnumber-sequence-4" author="fineract">
        <insert tableName="c_configuration">
            <column name="name" value="account-number-reuse-gaps"/>
            <column name="value"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="When enabled, reuse lowest missing numeric client account numbers before hi-lo forward allocation"/>
        </insert>
    </changeSet>

    <changeSet id="accountnumber-sequence-5" author="fineract">
        <insert tableName="c_configuration">
            <column name="name" value="account-number-gap-pool-batch-size"/>
            <column name="value" valueNumeric="100"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Max GAP rows inserted per gap-discovery refill into m_account_number_sequence"/>
        </insert>
    </changeSet>

    <changeSet id="accountnumber-sequence-6" author="fineract">
        <insert tableName="c_configuration">
            <column name="name" value="account-number-gap-pool-low-watermark"/>
            <column name="value" valueNumeric="10"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Refill GAP rows when count drops below this threshold"/>
        </insert>
    </changeSet>

</databaseChangeLog>
