<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="accountnumber-sequence-10" author="fineract">
        <update tableName="c_configuration">
            <column name="name" value="startup-gap-scan-fill-size"/>
            <where>name='account-number-gap-scan-window-size'</where>
        </update>
    </changeSet>

    <changeSet id="accountnumber-sequence-11" author="fineract">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM c_configuration WHERE name = 'startup-gap-scan-fill-size'</sqlCheck>
        </preConditions>
        <insert tableName="c_configuration">
            <column name="name" value="startup-gap-scan-fill-size"/>
            <column name="value" valueNumeric="2000"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Numeric suffix range scanned per gap-discovery pass when filling the GAP pool"/>
        </insert>
    </changeSet>

    <changeSet id="accountnumber-sequence-12" author="fineract">
        <insert tableName="c_configuration">
            <column name="name" value="account-number-gap-refill-max-windows"/>
            <column name="value" valueNumeric="50"/>
            <column name="date_value"/>
            <column name="string_value"/>
            <column name="enabled" valueBoolean="true"/>
            <column name="is_trap_door" valueBoolean="false"/>
            <column name="description" value="Safety cap on consecutive empty gap-discovery windows per refill run"/>
        </insert>
    </changeSet>

    <changeSet id="accountnumber-sequence-13" author="fineract">
        <insert tableName="job">
            <column name="name" value="Account Number Gap Maintenance"/>
            <column name="display_name" value="Account Number Gap Maintenance"/>
            <column name="cron_expression" value="0 0/5 * * * ?"/>
            <column name="create_time" valueDate="${current_datetime}"/>
            <column name="task_priority" valueNumeric="5"/>
            <column name="group_name"/>
            <column name="previous_run_start_time"/>
            <column name="job_key" value="Account Number Gap Maintenance _ DEFAULT"/>
            <column name="initializing_errorlog"/>
            <column name="is_active" valueBoolean="true"/>
            <column name="currently_running" valueBoolean="false"/>
            <column name="updates_allowed" valueBoolean="true"/>
            <column name="scheduler_group" valueNumeric="0"/>
            <column name="is_misfired" valueBoolean="false"/>
            <column name="node_id" valueNumeric="0"/>
            <column name="is_mismatched_job" valueBoolean="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
